html
  head
    meta(name="viewport", content="width=device-width, initial-scale=1")
    link(rel="shortcut icon", href="/images/image.png", type="image/png")
    link(rel='stylesheet', href='/styles/styles.css', type='text/css' )
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com")
    link(href="https://fonts.googleapis.com/css2?family=Montserrat+Alternates:wght@700&family=Montserrat:wght@500;700&family=Poppins&display=swap" rel="stylesheet")
    title= title
  body(class="bg-black")
    header(class="w-screen h-14 px-4 bg-white flex items-center absolute top-0")
      a(href="/", class="flex items-center")
        img(class="h-12 mr-3", src="/images/image.png", alt="Logomarca")
        p(class="font-[Montserrat] font-bold") Barbosa Recipes

    main(class="flex justify-center items-center min-h-screen px-5")

      div(class="flex flex-col items-center w-screen md:w-1/2")
        p(class="text-white mb-6 font-bold font-[Montserrat] text-4xl") Autenticação

        div(class="flex flex-col space-y-4 w-full")
          a(href="/auth/login", class="h-9 w-full text-white border flex items-center justify-center border-white rounded")
            p(class="text-sm font-[Montserrat] font-medium") Login

          a(href="/auth/register", class="h-9 w-full text-white border flex items-center justify-center border-white rounded")
            p(class="text-sm font-[Montserrat] font-medium") Cadastro
