html
  head
    meta(name="viewport", content="width=device-width, initial-scale=1")
    script(src="https://cdn.tailwindcss.com")
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com")
    link(href="https://fonts.googleapis.com/css2?family=Montserrat+Alternates:wght@700&family=Montserrat:wght@500;700&family=Poppins&display=swap" rel="stylesheet")
    title= title
  body(class="bg-gradient-to-b from-[#3850EC] to-[#BFD1F8]")
    main(class="flex flex-col items-center justify-center min-h-screen")
      
      div(class="min-h-[330px] bg-white rounded-xl flex flex-col items-center")
        div(class="bg-gray-300 p-4 rounded-tl-xl rounded-tr-xl space-y-5 flex flex-col items-center justify-center")
          img(src="/images/logo.png", alt="Logo")
          p(class="font-[Poppins] font-normal text-xl") The monitoring app for you!

        div(class="flex flex-col items-center bg-white py-4")
          p(class="mt-8 text-xl font-bold font-[Poppins]") Login

          form(class="space-y-6 flex flex-col mt-8",action="/auth/callback/app", method="get")
            div(class="flex flex-col")
              label(for="email", class="text-sm text-gray-500 opacity-75 font-[Poppins] font-normal") Nome de usuário ou e-mail
              input(type="email", name="email",class="p-2 bg-[#EDF0F6] rounded-lg font-normal font-[Montserrat]")

            div(class="flex flex-col")
              label(for="password", class="text-sm text-gray-500 opacity-75 font-[Poppins] font-normal") Senha
              input(type="password", name="password", class="p-2 bg-[#EDF0F6] rounded-lg font-normal font-[Montserrat]")

            button(type="submit", class="bg-[#3850EC] p-2 rounded-md min-h-[40px] text-white font-[Montserrat] font-semi") Logar
